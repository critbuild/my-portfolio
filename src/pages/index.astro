---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChapterKicker from '../components/ChapterKicker.astro';
import Icon from '../components/Icon.astro';
import { profile, projects } from '../data/portfolio';

const base = import.meta.env.BASE_URL;
---
<BaseLayout title={`${profile.name} — Beyond the ordinary`} description={profile.description} home>
  <section class="hero scene" aria-labelledby="hero-title" data-ambient>
    <div class="hero-sky" aria-hidden="true"></div>
    <div class="hero-orbit" aria-hidden="true"><span></span></div>
    <div class="hero-landscape"><img class="hero-mountains" src={`${base}art/mountains.svg`} width="1600" height="1000" alt="" fetchpriority="high" /></div>
    <div class="mist-band" aria-hidden="true"></div>
    <div class="hero-copy container">
      <p class="eyebrow hero-eyebrow"><span class="small-diamond"></span> {profile.name.toUpperCase()} / CREATIVE DEVELOPMENT</p>
      <h1 id="hero-title"><span class="hero-title-line"><span>Beyond the</span></span><span class="hero-title-line"><span class="accent-text">ordinary.</span></span></h1>
      <div class="hero-bottom">
        <p class="hero-description">Thoughtful interfaces. Purposeful systems.<br />Exploring the space between what works and what moves you.</p>
        <div class="hero-actions">
          <a class="button button--primary" href="#work">Explore my work <Icon name="arrow-down" /></a>
          <a class="text-link" href="#about">The person behind it <Icon /></a>
        </div>
      </div>
      <nav class="hero-index" aria-label="From the workbench">
        <span class="eyebrow">FROM THE WORKBENCH</span>
        {projects.map((project) => (
          <a href={`${base}projects/${project.slug}/`}><span class="hero-project-number">{project.number}</span><span>{project.title}</span><Icon /></a>
        ))}
      </nav>
    </div>
    <div class="hero-foot container">
      <a class="scroll-cue" href="#work"><span class="scroll-line"></span> SCROLL TO EXPLORE</a>
      <span class="hero-edition">{profile.name} <span>/</span> DIGITAL PORTFOLIO</span>
      <button class="motion-toggle" type="button" data-motion-toggle aria-pressed="true" hidden>
        <span class="motion-symbol" aria-hidden="true"><i></i><i></i><i></i></span><span data-motion-label>MOTION ON</span>
      </button>
    </div>
  </section>

  <section class="work-section scene section-pad" id="work" aria-labelledby="work-title">
    <div class="container scene-inner">
      <ChapterKicker number="01" label="SELECTED WORK" />
      <div class="section-heading work-heading">
        <h2 id="work-title" data-reveal-frame><span class="title-line"><span data-reveal="title">Ideas, made <span class="accent-text">real.</span></span></span></h2>
        <p>A selection of tools, systems,<br />and small obsessions brought to life.</p>
      </div>
      <div class="project-grid">
        {projects.map((project) => (
          <a class="project-card" href={`${base}projects/${project.slug}/`} aria-label={`Explore ${project.title} — ${project.category}`}>
            <div class="project-image" data-reveal-frame data-reveal-surface>
              <img src={`${base}${project.art.slice(1)}`} width="1000" height="660" alt={`Original conceptual illustration for ${project.title}`} loading="lazy" decoding="async" data-reveal="media" />
              <span class="project-image-number">/{project.number}</span>
              <span class="project-image-action"><Icon /></span>
              <span class="project-image-label">{project.category}</span>
            </div>
            <div class="project-card-heading"><h3>{project.title}<span>.</span></h3><Icon /></div>
            <p class="project-summary">{project.summary}</p>
            <ul class="project-stack" aria-label="Technologies">{project.stack.slice(0, 3).map((tech) => <li>{tech}</li>)}</ul>
          </a>
        ))}
      </div>
      <p class="work-note"><span class="small-diamond"></span> Different tools. The same attention to detail.</p>
    </div>
  </section>

  <section class="about-section scene section-pad" id="about" aria-labelledby="about-title">
    <div class="container scene-inner">
      <ChapterKicker number="02" label="BEHIND THE WORK" />
      <div class="about-grid">
        <div class="about-heading">
          <p class="eyebrow about-intro">HELLO, I’M {profile.name.toUpperCase()}.</p>
          <h2 id="about-title" data-reveal-frame>
            <span class="title-line"><span data-reveal="title">Curiosity</span></span>
            <span class="title-line"><span data-reveal="title">is the</span></span>
            <span class="title-line"><span data-reveal="title"><span class="about-highlight">constant.</span></span></span>
          </h2>
        </div>
        <div class="about-copy">
          <p class="about-lead">I like building things that feel as good to use as they are to look at.</p>
          <p>Thoughtful interfaces. Useful tools. Systems that get out of the way. This is a space for the work, experiments, and ideas that live at the intersection of design and engineering.</p>
          <p>The approach is simple: make the complex feel clear, sweat the small details, and leave out what doesn’t need to be there.</p>
        </div>
      </div>
      <div class="approach-list">
        <div><Icon name="layers" /><h3>Considered by design</h3><span>Clarity in every interaction.</span></div>
        <div><Icon name="code" /><h3>Carefully engineered</h3><span>Purpose in every line.</span></div>
        <div><Icon name="spark" /><h3>Light by intention</h3><span>Less overhead. More experience.</span></div>
      </div>
    </div>
  </section>

  <section class="contact-section scene section-pad" id="contact" aria-labelledby="contact-title">
    <div class="container scene-inner">
      <ChapterKicker number="03" label="NEXT CHAPTER" />
      <div class="contact-grid">
        <div>
          <p class="eyebrow contact-eyebrow">GOOD THINGS START WITH A CONVERSATION.</p>
          <h2 id="contact-title" data-reveal-frame>
            <span class="title-line"><span data-reveal="title">Let’s</span></span>
            <span class="title-line"><span data-reveal="title">make it</span></span>
            <span class="title-line"><span data-reveal="title">real.</span></span>
          </h2>
        </div>
        <a class="contact-link" href={profile.github} target="_blank" rel="noopener noreferrer" aria-label={`Find ${profile.name} on GitHub`}>
          <Icon />
          <span>LET’S TALK <span aria-hidden="true">/</span> GITHUB</span>
        </a>
      </div>
      <div class="contact-bottom">
        <p>An interesting idea, a different perspective,<br />or just a hello. I’d like to hear it.</p>
        <a class="contact-address" href={profile.github} target="_blank" rel="noopener noreferrer">{profile.github.replace('https://', '')} <Icon /></a>
      </div>
    </div>
  </section>
</BaseLayout>
